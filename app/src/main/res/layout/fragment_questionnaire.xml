<!-- res/layout/fragment_questionnaire.xml -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Personalicemos tu rutina!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:layout_marginBottom="32dp"/>

        <!-- Pregunta 1: Experiencia -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Has hecho ejercicio regularmente en los últimos 3 meses?"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgExperience"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <RadioButton
                android:id="@+id/rbExperienceYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sí"/>

            <RadioButton
                android:id="@+id/rbExperienceNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                android:checked="true"/>
        </RadioGroup>

        <!-- Pregunta 2: Dolor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Sientes alguna molestia o dolor articular hoy?"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgPain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <RadioButton
                android:id="@+id/rbPainYes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sí"/>
            <RadioButton
                android:id="@+id/rbPainNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No"
                android:checked="true"/>
        </RadioGroup>

        <!-- Pregunta 3: Intensidad -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Buscas una rutina suave o un desafío intenso?"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgIntensity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <RadioButton
                android:id="@+id/rbIntensitySoft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Suave"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/rbIntensityHard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Intenso"/>
        </RadioGroup>

        <!-- Pregunta 4: Objetivo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¿Tu objetivo es ganar fuerza o mejorar flexibilidad?"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <RadioGroup
            android:id="@+id/rgGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">
            <RadioButton
                android:id="@+id/rbGoalStrength"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fuerza"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/rbGoalFlexibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flexibilidad"/>
        </RadioGroup>


        <Button
            android:id="@+id/btnGenerateRoutine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear mi rutina personalizada"
            android:padding="16dp"
            android:textSize="18sp"/>

    </LinearLayout>
</ScrollView>
