<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo4"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Botón atrás -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:contentDescription="Botón para retroceder"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:text="Ajustes y Comunidad"
            android:textColor="@color/azul_texto"
            android:textSize="26sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBack" />

        <!-- Bloque de Notificaciones -->
        <LinearLayout
            android:id="@+id/input_background"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/input_background"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle">

            <ImageView
                android:id="@+id/iconNotifications"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_notification"
                android:contentDescription="Icono de notificaciones"
                app:tint="@color/azul_texto" />

            <TextView
                android:id="@+id/tvNotifications"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/nunito"
                android:text="Notificaciones"
                android:textColor="@color/azul_texto"
                android:textSize="16sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchNotifications"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/azul_texto"
                android:trackTint="@color/azul_texto" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSoporte"
            android:layout_width="292dp"
            android:layout_height="47dp"
            android:layout_marginTop="124dp"
            android:text="Soporte"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/azul_texto"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_settings"
            app:iconPadding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/input_background" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProgreso"
            android:layout_width="292dp"
            android:layout_height="45dp"
            android:layout_marginTop="12dp"
            android:text="Ver progreso"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/azul_texto"
            app:cornerRadius="16dp"
            app:icon="@drawable/chart_placeholder"
            app:iconPadding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnSoporte" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnComunidad"
            android:layout_width="292dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Unirse a la comunidad"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/azul_texto"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_community"
            app:iconPadding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnProgreso" />

        <!-- ✅ NUEVO BOTÓN CAMBIAR CATEGORÍA -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCambiarCategoria"
            android:layout_width="292dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Cambiar categoría"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="@color/azul_texto"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_settings"
            app:iconPadding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnComunidad" />

        <!-- Botón Cerrar Sesión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            android:layout_width="275dp"
            android:layout_height="45dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="5dp"
            android:text="Cerrar sesión"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            app:backgroundTint="#E53935"
            app:cornerRadius="16dp"
            app:icon="@drawable/ic_logout"
            app:iconPadding="8dp"
            app:iconTint="@android:color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnCambiarCategoria" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
