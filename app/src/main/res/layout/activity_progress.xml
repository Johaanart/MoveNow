<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroundcross">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:id="@+id/tvTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:text="Tu Progreso 📊"
            android:textColor="@color/azul_texto"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Resumen -->
        <TextView
            android:id="@+id/tvResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:text="Resumen de tu avance semanal:"
            android:textColor="@android:color/black"
            android:textSize="18sp" />

        <!-- Placeholder gráfico -->
        <ImageView
            android:id="@+id/chartProgress"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="120dp"
            android:scaleType="fitCenter"
            android:src="@drawable/chart_placeholder_bg" />

        <!-- Línea divisoria -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:background="#CCCCCC" />

        <!-- Indicadores de progreso -->
        <TextView
            android:id="@+id/tvEjercicio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/nunito"
            android:text="Ejercicio físico: 0%"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/pbEjercicio"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#2196F3" />

        <TextView
            android:id="@+id/tvAgua"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/nunito"
            android:text="Hidratación: 0%"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/pbAgua"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#4CAF50" />

        <!-- Botón -->
        <Button
            android:id="@+id/btnDetalles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/azul_texto"
            android:text="Ver más detalles"
            android:textColor="@android:color/white" />
    </LinearLayout>
</ScrollView>
