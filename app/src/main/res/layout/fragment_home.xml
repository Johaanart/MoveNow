<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background_home"
    tools:context="ui.main.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Saludo -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:fontFamily="@font/nunito"
            android:gravity="center"
            android:text="¡Hola, bienvenido a MoveNow!"
            android:textColor="@color/azul_texto"
            android:textSize="26sp"
            android:textStyle="bold"
            android:shadowColor="@color/azul_texto"
            android:shadowRadius="1.5"
            android:shadowDx="1"
            android:shadowDy="1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botón principal -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="284dp"
            android:padding="16dp"
            android:text="Empezar Rutina"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:fontFamily="@font/nunito"
            app:backgroundTint="@color/azul_texto"
            app:cornerRadius="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvGreeting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Lista de metas -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/menuGoals"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Mis metas"
            app:boxBackgroundColor="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/btnStart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <AutoCompleteTextView
                android:id="@+id/autoCompleteTextViewGoals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:fontFamily="@font/nunito"
                android:textColor="@color/azul_texto"
                tools:ignore="LabelFor" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Barra de progreso diaria -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressDaily"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:progress="0"
            android:max="100"
            app:indicatorColor="@color/azul_texto"
            app:trackColor="@android:color/darker_gray"
            app:trackCornerRadius="10dp"
            app:trackThickness="12dp"
            app:layout_constraintTop_toBottomOf="@id/menuGoals"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botón ver progreso -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProgreso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ver progreso"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:fontFamily="@font/nunito"
            android:paddingVertical="12dp"
            app:backgroundTint="@color/azul_texto"
            app:cornerRadius="16dp"
            app:layout_constraintTop_toBottomOf="@id/progressDaily"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
